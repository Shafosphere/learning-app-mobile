@@ -0,0 +1,10 @@
+export function getRotationGeometry(contentWidth, contentHeight, width, height, degrees) {
+  'worklet';
+  const radians = degrees * Math.PI / 180;
+  const cos = Math.abs(Math.cos(radians));
+  const sin = Math.abs(Math.sin(radians));
+  const rotatedWidth = contentWidth * cos + contentHeight * sin;
+  const rotatedHeight = contentWidth * sin + contentHeight * cos;
+  const fitScale = Math.min(1, width / rotatedWidth, height / rotatedHeight);
+  return { width: rotatedWidth * fitScale, height: rotatedHeight * fitScale, fitScale };
+}
